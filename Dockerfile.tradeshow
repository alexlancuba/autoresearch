FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY pyproject.toml ./
COPY tradeshow_agent/ ./tradeshow_agent/

# Install Python dependencies (only what the tradeshow agent needs)
RUN pip install --no-cache-dir requests pandas anthropic

# Create data directories
RUN mkdir -p /root/.cache/autoresearch/tradeshow /app/tradeshow_reports

# Health check - hits the /api/health endpoint
HEALTHCHECK --interval=60s --timeout=10s --retries=3 --start-period=30s \
    CMD curl -f http://localhost:8050/api/health || exit 1

# Expose dashboard port
EXPOSE 8050

# Default: run continuous mode with dashboard
# Override CMD for different modes
CMD ["python", "-m", "tradeshow_agent", "--continuous", "--ui", "--interval", "30", "--format", "json"]
