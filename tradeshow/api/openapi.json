            },
            "type": "array",
            "title": "Cycles"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "cycles",
          "count"
        ],
        "title": "CycleListResponse"
      },
      "CycleResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "default": ""
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp",
            "default": ""
          },
          "scan_type": {
            "type": "string",
            "title": "Scan Type",
            "default": ""
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": ""
          },
          "signal_count": {
            "type": "integer",
            "title": "Signal Count",
            "default": 0
          },
          "trend_count": {
            "type": "integer",
            "title": "Trend Count",
            "default": 0
          },
          "industries_covered": {
            "type": "integer",
            "title": "Industries Covered",
            "default": 0
          },
          "regions_covered": {
            "type": "integer",
            "title": "Regions Covered",
            "default": 0
          },
          "model_version": {
            "type": "string",
            "title": "Model Version",
            "default": ""
          },
          "predictions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Predictions"
          },
          "eval_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eval Score"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "CycleResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
