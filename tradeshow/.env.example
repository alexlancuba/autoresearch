# Trade Show Trend Analysis — Backend Configuration
# Copy to .env and fill in values

# API Server
PORT=8000
HOST=0.0.0.0

# CORS (comma-separated origins, or * for dev)
# Example: CORS_ORIGINS=https://your-app.lovable.app,http://localhost:3000
CORS_ORIGINS=*

# Data directory (default: ./data relative to tradeshow/)
DATA_DIR=./data

# Scraping API Keys (optional — scrapers degrade gracefully without these)
YOUTUBE_API_KEY=
TWITTER_BEARER_TOKEN=
ANTHROPIC_API_KEY=
