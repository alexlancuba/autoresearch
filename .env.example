# Trade Show Trend Analysis Agent - Environment Variables
# Copy this to .env and fill in your values

# --- Claude AI (enables AI-powered trend extraction & SME briefings) ---
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Slack Notifications (optional) ---
# Create an Incoming Webhook at: https://api.slack.com/messaging/webhooks
TRADESHOW_SLACK_WEBHOOK=

# --- Email Notifications (optional) ---
TRADESHOW_SMTP_HOST=smtp.gmail.com
TRADESHOW_SMTP_USER=
TRADESHOW_SMTP_PASSWORD=
TRADESHOW_EMAIL_FROM=
TRADESHOW_EMAIL_TO=rep1@company.com,rep2@company.com

# --- Generic Webhook (optional) ---
# Any endpoint that accepts POST with JSON body
TRADESHOW_WEBHOOK_URL=
